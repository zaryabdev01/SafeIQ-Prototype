docker compose up --build# Copy to .env and adjust for local dev. Real staging/prod values live in
# Secrets Manager per solution-architecture-aws-design.md, not in a file.

# --- Database (control-plane + tenant schemas, one Postgres cluster) ---
DATABASE_URL=postgresql+asyncpg://safeiq:safeiq@localhost:5432/safeiq

# --- JWT ---
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=43200
ONBOARDING_TOKEN_EXPIRE_MINUTES=30

# --- App ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# --- Email ---
# console = logs the email instead of sending (dev default)
# ses     = TBC, not implemented yet (see backend/README.md)
EMAIL_BACKEND=console

# --- KYC ---
# mock   = auto-approves every verification (dev default)
# onfido = TBC with client (see Questions & Concerns in the milestone plan) - not implemented yet
KYC_PROVIDER=mock

# --- Onboarding CMS "AI-assisted search" (Milestone 3, task 24) ---
# keyword = word-overlap matching (dev default, ported from the frontend prototype)
# llm     = TBC - blocked on the LLM provider decision (milestone plan, Questions & Concerns, CRITICAL)
ONBOARDING_SEARCH_PROVIDER=keyword

# --- Invites / OTP ---
OTP_EXPIRE_MINUTES=10
INVITE_EXPIRE_DAYS=14
MAGIC_LINK_BASE_URL=http://localhost:3000/invite
