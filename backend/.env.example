# Copy to .env and adjust for local dev. Real staging/prod values live in
# Secrets Manager per solution-architecture-aws-design.md, not in a file.

# --- Database (control-plane + tenant schemas, one Postgres cluster) ---
DATABASE_URL=postgresql+asyncpg://safeiq:safeiq@localhost:5432/safeiq

# --- JWT ---
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=43200
ONBOARDING_TOKEN_EXPIRE_MINUTES=30

# --- App ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# --- Email ---
# console = logs the email instead of sending (dev default)
# smtp    = real SMTP send (Gmail SMTP interim; AWS SES over SMTP for production)
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=SafeIQ
SMTP_USE_TLS=true

# --- KYC ---
# mock   = auto-approves every verification (dev default)
# sumsub = real Sumsub verification; outcome arrives async on POST /kyc/webhook
KYC_PROVIDER=mock
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_WEBHOOK_SECRET=
SUMSUB_BASE_URL=https://api.sumsub.com
SUMSUB_LEVEL_NAME=id-and-liveness
# Only for local testing without the shared webhook secret - never true in a deployed env.
KYC_ALLOW_UNVERIFIED_WEBHOOK_APPROVAL=false

# --- Onboarding CMS "AI-assisted search" (Milestone 3, task 24) ---
# keyword = word-overlap matching (dev default, ported from the frontend prototype)
# llm     = OpenAI-ranked guided path; falls back to keyword if the API call fails
ONBOARDING_SEARCH_PROVIDER=keyword
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Cloudflare Turnstile (CAPTCHA). Verification middleware is not wired yet;
# these are recognised so a full .env doesn't carry orphan keys. ---
CAPTCHA_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Invites / OTP ---
OTP_EXPIRE_MINUTES=10
INVITE_EXPIRE_DAYS=14
MAGIC_LINK_BASE_URL=http://localhost:3000/invite
