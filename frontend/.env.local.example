# Copy to .env.local for local development.
# URL of the real backend (see ../backend) - used by src/lib/apiClient.ts for the
# real signup/login/invite/team/settings/audit flows. Everything else in this app
# (RAGs, alerts, chat, dashboard, calendar) still runs on the mock store and does
# not need the backend running.
NEXT_PUBLIC_API_URL=http://localhost:8000
