# Copy to .env.local for local development.
# URL of the real backend (see ../backend) - used by src/lib/apiClient.ts for the
# real signup/login/invite/team/settings/audit flows. Everything else in this app
# (RAGs, alerts, chat, dashboard, calendar) still runs on the mock store and does
# not need the backend running.
#
# Local backend (default):
NEXT_PUBLIC_API_URL=http://localhost:8000
#
# Shared dev API (use https — http redirects and breaks CORS preflight):
# NEXT_PUBLIC_API_URL=https://safeiq-dev-api.theittraininghub.com
#
# When NEXT_PUBLIC_API_URL points at a remote host, `next dev` automatically
# proxies requests through /api-proxy so localhost does not need to be in the
# backend's CORS_ORIGINS list.
