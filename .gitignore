# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# --- frontend (Next.js) ---
frontend/node_modules
frontend/.next/
frontend/out/
frontend/build
frontend/next-env.d.ts
frontend/*.tsbuildinfo
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
/coverage
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts
.vercel

# --- backend (FastAPI / Python) ---
backend/.venv/
backend/venv/
backend/__pycache__/
backend/**/__pycache__/
